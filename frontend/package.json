{
  "name": "@secure-player/react",
  "version": "1.0.0",
  "description": "Enterprise-grade React video player with AES-128 HLS decryption, proxy playlist support, and anti-tamper security controls",
  "type": "module",
  "main": "./dist/lib/secure-player.umd.js",
  "module": "./dist/lib/secure-player.es.js",
  "types": "./dist/lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/types/index.d.ts",
      "import": "./dist/lib/secure-player.es.js",
      "require": "./dist/lib/secure-player.umd.js"
    },
    "./style.css": "./dist/lib/react.css",
    "./react.css": "./dist/lib/react.css"
  },
  "files": [
    "dist/lib",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build:app": "tsc && vite build",
    "build:lib": "vite build --config vite.config.lib.ts",
    "build": "npm run build:app && npm run build:lib",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "hls.js": "^1.5.18",
    "lucide-react": "^0.475.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "secure-player-monorepo": "file:.."
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "terser": "^5.39.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vite-plugin-dts": "^4.5.3"
  }
}
